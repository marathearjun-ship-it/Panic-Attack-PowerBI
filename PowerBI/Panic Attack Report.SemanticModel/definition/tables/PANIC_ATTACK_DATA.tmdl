	column 'Age Group IF' = ```
			
			    IF(
			        'PANIC_ATTACK_DATA'[AGE]<= 17, "Child",
			            IF(
			                'PANIC_ATTACK_DATA'[AGE]<= 24, "Adolecient",
			                    IF(
			                        'PANIC_ATTACK_DATA'[AGE]<= 64, "Adult",
			                            "Senior"
			                    )
			            )
			    )
			```
		lineageTag: 1e21f07e-487d-42c1-b6ee-3b78cd3180da
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Age Group Switch' = ```
			
			    SWITCH(
			        TRUE(),
			        'PANIC_ATTACK_DATA'[AGE] <= 17, "Child",
			        'PANIC_ATTACK_DATA'[AGE] <= 24, "Adolecent",
			        'PANIC_ATTACK_DATA'[AGE] <= 64, "Adult",
			        "Senior"
			    )
			```
		lineageTag: 99a2f93c-5322-4529-bb2c-0805de3099ad
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

