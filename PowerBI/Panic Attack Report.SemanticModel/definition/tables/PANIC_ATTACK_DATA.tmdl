	measure '% Patients Diziness' = ```
			
			    DIVIDE(
			        COUNTROWS(
			                FILTER('PANIC_ATTACK_DATA', PANIC_ATTACK_DATA[DIZZINESS] = TRUE())),
			        COUNTROWS('PANIC_ATTACK_DATA'), 
			        0
			    ) 
			```
		formatString: 0.00%;-0.00%;0.00%
